#!/bin/sh
# 中文说明：按用户要求开启无密码 AP，SSID 等于机型名，不加频段后缀。
. /lib/functions.sh
case "$(board_name)" in
    hinlink,opc-h66k) model=H66K ;;
    hinlink,opc-h68k) model=H68K ;;
    hinlink,opc-h69k) model=H69K ;;
    *) exit 1 ;;
esac
wifi config || exit 1
test -s /etc/config/wireless || exit 1
found=0
enable_radio() {
    uci set "wireless.$1.disabled=0"
}
enable_ap() {
    local mode
    config_get mode "$1" mode
    [ "$mode" = ap ] || return 0
    uci set "wireless.$1.ssid=$model"
    uci set "wireless.$1.encryption=none"
    uci -q delete "wireless.$1.key" || :
    uci set "wireless.$1.disabled=0"
    found=1
}
config_load wireless
config_foreach enable_radio wifi-device
config_foreach enable_ap wifi-iface
[ "$found" = 1 ] || exit 1
uci commit wireless
# 一次性默认值；成功后由系统移除，不在每次启动时重置用户设置。
exit 0
