# 中文说明：每个镜像只携带对应设备的 rockchip.dtb；不再自动识别三款机型。
# H69K 的 GPIO0_C0 复位动作由自己的设备树电源节点控制。
part uuid mmc ${devnum}:2 uuid
setenv bootargs "console=ttyS2,1500000 earlycon=uart8250,mmio32,0xfe660000 root=PARTUUID=${uuid} rw rootwait"
if load mmc ${devnum}:1 ${fdt_addr_r} rockchip.dtb; then
  if load mmc ${devnum}:1 ${kernel_addr_r} kernel.img; then
    booti ${kernel_addr_r} - ${fdt_addr_r}
  fi
fi
