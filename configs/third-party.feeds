# src-git optional_natmapt_core https://github.com/muink/openwrt-natmapt.git;master
# STUNTMAN（根目录配方；上方已有固定提交及专门接入逻辑）
# src-git optional_stuntman https://github.com/muink/openwrt-stuntman.git;master
# EasyTier
